# ================= Olimpiada tizimi sozlamalari =================
# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring:
#   cp .env.example .env

# Telegram bot tokeni (@BotFather dan olinadi)
BOT_TOKEN=1234567890:AAAA...

# Sessiyalar uchun maxfiy kalit — albatta o'zgartiring!
# Yaratish: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Birinchi admin (faqat baza bo'sh bo'lganda yaratiladi).
# Kirgandan keyin parolni panelda almashtiring va bu qatorni tozalashingiz mumkin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# HTTPS (domen + SSL) sozlangandan keyin true qiling
COOKIE_SECURE=false

# Admin sessiyasi necha soat amal qiladi
SESSION_HOURS=12

# Vaqt mintaqasi
TZ_NAME=Asia/Tashkent

# Saqlanadigan zaxira nusxalar soni
BACKUP_KEEP=30

# Ommaviy xabar tezligi (sekundiga). Telegram cheklovi ~30.
BROADCAST_RATE=20
