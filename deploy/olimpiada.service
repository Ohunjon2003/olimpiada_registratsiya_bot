# systemd xizmati: server yonganda avtomatik ishga tushadi, xato bo'lsa qayta ishga tushadi.
[Unit]
Description=Olimpiada: Telegram bot + web panel
After=network-online.target
Wants=network-online.target

[Service]
User=olimpiada
Group=olimpiada
WorkingDirectory=/opt/olimpiada
# Sozlamalar /opt/olimpiada/.env faylidan o'qiladi
# DIQQAT: --workers 1 bo'lishi shart (bot bitta nusxada ishlashi kerak)
ExecStart=/opt/olimpiada/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
# Xavfsizlik cheklovlari
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/olimpiada/data

[Install]
WantedBy=multi-user.target
